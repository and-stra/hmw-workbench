+def convert_attachments(weapon, keep=(), mapping=None):
+    """New attachments list + re-indexed animOverrides. keep: AW names kept as they are; mapping: AW name -> HMW name.
+    attachment1/attachment2 are 1-based indices into the list (0 = none)."""
+    mapping = mapping or {}
+    source = [a if isinstance(a, str) else "" for a in as_list(weapon.get("attachments"))]
+    new_list = []
+    index_map = {0: 0}
+    for i, name in enumerate(source):
+        target = mapping.get(name) or (name if name in keep else None)
+        if target:
+            if target not in new_list:
+                new_list.append(target)
+            index_map[i + 1] = new_list.index(target) + 1
+    missing = [a for a in list(keep) + list(mapping) if a not in source]
+    if missing:
+        print("warning: attachments not on the weapon: %s" % ", ".join(missing))
+    weapon["attachments"] = new_list
+
+    kept, dropped, retyped = [], 0, 0
+    for override in as_list(weapon.get("animOverrides")):
+        if not isinstance(override, dict):
+            continue
+        a1, a2 = override.get("attachment1", 0) or 0, override.get("attachment2", 0) or 0
+        if a1 not in index_map or a2 not in index_map:
+            dropped += 1
+            continue
+        override["attachment1"], override["attachment2"] = index_map[a1], index_map[a2]
+        tree = override.get("animTreeType", 0) or 0
+        if tree in S1_TO_H1_ANIM_TREE:
+            override["animTreeType"] = S1_TO_H1_ANIM_TREE[tree]
+            retyped += 1
+        kept.append(override)
+    weapon["animOverrides"] = kept
+    print("animOverrides: %d kept (%d animTreeType converted), %d dropped with their attachments" % (
+        len(kept), retyped, dropped))
+
+
 EXO_ANIM_PREFIXES = ("HIGH_JUMP_", "DODGE_", "SLIDE_", "SPRINTANDFIRE_", "MELEE_ALT_", "LAND_DIP", "SPRINT_IN_FROM_SLIDE")
 
 
